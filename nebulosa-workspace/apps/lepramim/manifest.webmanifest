{
  "name": "LêPraMim",
  "short_name": "LêPraMim",
  "description": "Software de Leitura e Audiolivros para Computador — lê ebooks e documentos em voz alta e toca audiobooks, 100% offline.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#2563EB",
  "icons": [
    { "src": "assets/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/plain": [".txt"],
        "application/rtf": [".rtf"],
        "text/html": [".html", ".htm"],
        "audio/*": [".mp3", ".m4a", ".m4b", ".aac", ".ogg", ".wav", ".flac"]
      }
    }
  ]
}
